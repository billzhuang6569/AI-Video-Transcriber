# Summary / translation API configuration
# Can be any OpenAI-compatible chat endpoint, or leave empty and fill it in the UI.
OPENAI_API_KEY=your_summary_api_key_here

# Optional: Custom OpenAI-compatible Base URL for summary / translation
OPENAI_BASE_URL=https://api.openai.com/v1

# Transcription provider: openai, openrouter, or elevenlabs
TRANSCRIPTION_PROVIDER=openrouter

# OpenAI/OpenRouter transcription
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_TRANSCRIPTION_API_KEY=your_transcription_api_key_here
# OPENAI_TRANSCRIPTION_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo

# ElevenLabs transcription
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_TRANSCRIPTION_MODEL=scribe_v2

# Transcription upload chunk size limit in MB
OPENAI_TRANSCRIPTION_MAX_MB=24

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000

# Local upload size limit in MB (optional; Docker Compose passes this through)
UPLOAD_MAX_MB=200

# Optional yt-dlp login cookies and JavaScript runtime for protected video sites
# YTDLP_COOKIE_FILE=/absolute/path/to/cookies.txt
YTDLP_JS_RUNTIME=node
# YTDLP_JS_RUNTIME_PATH=/absolute/path/to/node
